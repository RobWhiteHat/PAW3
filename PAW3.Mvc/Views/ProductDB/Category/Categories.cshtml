@model ProductDBViewModel
@{}

<div class="text-center">
    <h1 class="display-4">Welcome to @Model.Title</h1>
    <p>Learn about <a href="https://learn.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>
</div>
<div class="mb-3 text-end">
    <a asp-action="CreateCategory" class="btn btn-success">
        <i class="bi bi-plus-circle"></i> Nueva Categoría
    </a>
</div>

<div class="table-responsive">
    <table class="table table-dark table-striped">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Description</th>
                <th>Last Modified</th>
                <th>Modified by</th>
                <th>Acciones</th> <!-- Nuevo campo -->
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Categories)
            {
            <tr>
                <td>@item.CategoryId</td>
                <td>@item.CategoryName</td>
                <td>@item.Description</td>
                <td>@item.LastModified</td>
                <td>@item.ModifiedBy</td>
                <td>
                    <a asp-action="EditCategory" asp-route-id="@item.CategoryId" class="btn btn-sm btn-warning">
                        <i class="bi bi-pencil-square"></i> Editar
                    </a>

                    <form asp-action="DeleteCategory" asp-route-id="@item.CategoryId" method="post" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('¿Seguro que deseas eliminar esta categoría?');">
                            <i class="bi bi-trash"></i> Eliminar
                        </button>
                    </form>
                </td>
            </tr>
            }
        </tbody>
    </table>
</div>
